rules_version = '2';

// Task proof photos: households/{householdId}/taskPhotos/{taskId}/{file}

service firebase.storage {
  match /b/{bucket}/o {
    function isMember(householdId) {
      return request.auth != null &&
        firestore.get(/databases/(default)/documents/households/$(householdId))
          .data.memberIds.hasAny([request.auth.uid]);
    }

    // Photo proof is a Premium feature (households/{id}.premiumUntil is
    // kept by the server; see functions/src/premium).
    function hasPremium(householdId) {
      let until = firestore.get(/databases/(default)/documents/households/$(householdId))
        .data.get('premiumUntil', null);
      return until is timestamp && until > request.time;
    }

    // Only parents review proof photos (the app shows them only to parents),
    // so children can't open each other's photos.
    function isParentMember(householdId) {
      return isMember(householdId) &&
        firestore.get(/databases/(default)/documents/users/$(request.auth.uid))
          .data.role == 'parent';
    }

    match /households/{householdId}/taskPhotos/{taskId}/{fileName} {
      allow read: if isParentMember(householdId);
      allow create: if isMember(householdId) && hasPremium(householdId) &&
        request.resource.size < 8 * 1024 * 1024 &&
        request.resource.contentType.matches('image/.*');
      allow update, delete: if false;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
