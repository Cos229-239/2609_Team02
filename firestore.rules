rules_version = '2';

// Data model:
//   users/{uid}                       - profile: name, email, role, xp, coins,
//                                       householdId (the ACTIVE household), pendingHouseholdIds, ...
//                                       premium (server only: Premium subscription summary)
//   users/{uid}/fcmTokens/{token}     - push-notification device tokens (owner only)
//   households/{householdId}          - name, ownerId (admin), memberIds, inviteCode,
//                                       timezone (IANA), nextRunAt (server),
//                                       premiumUntil (server: when the admin's Premium ends)
//   households/{householdId}/joinRequests/{uid} - "let me in" requests the admin approves
//   households/{householdId}/tasks/{taskId}
//   households/{householdId}/taskSchedules/{scheduleId} - repeating tasks
//   households/{householdId}/rewards/{rewardId}
//   households/{householdId}/redemptions/{redemptionId}
//   subscriptions/{id}                - store subscriptions (server only; no client access)
//   premiumGrants/{uid}               - complimentary Premium for test accounts (console only)
//
// Premium: a household has Premium features (photo proof) while its admin
// has a Premium subscription. Cloud Functions (functions/src/premium) verify
// purchases with the App Store / Google Play and keep `users/{uid}.premium`
// and `households/{id}.premiumUntil` up to date; clients can't write either.
//
// Membership: `households/{id}.memberIds` is the only source of truth. A user
// can be in several households; XP and coins live on the user so they carry
// across all of them.
//
// Joining: an invite code only lets someone file a join request. Nobody can
// add themself to `memberIds`; the household's admin (ownerId) approves. A
// parent member may also add a child account they just created in the app.
//
// `households` documents (including their inviteCode) are readable by any
// signed-in user so an account can look a household up by code before it's a
// member, and list the households it belongs to.
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function selfProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isParent() {
      return selfProfile().role == 'parent';
    }

    function householdData(householdId) {
      return get(/databases/$(database)/documents/households/$(householdId)).data;
    }

    function isMemberOf(householdId) {
      return isSignedIn() &&
        householdData(householdId).memberIds.hasAny([request.auth.uid]);
    }

    // The household's admin has Premium right now (see functions/src/premium).
    function householdHasPremium(householdId) {
      let until = householdData(householdId).get('premiumUntil', null);
      return until is timestamp && until > request.time;
    }

    function userData(userId) {
      return get(/databases/$(database)/documents/users/$(userId)).data;
    }

    // The caller and [userId] are both members of the caller's active
    // household (checked against that household's memberIds, which nobody
    // can add themself to).
    function sharesActiveHousehold(userId) {
      let active = selfProfile().get('householdId', null);
      return active is string &&
        householdData(active).memberIds.hasAll([request.auth.uid, userId]);
    }

    match /users/{userId} {
      allow read: if isSignedIn() &&
        (request.auth.uid == userId || sharesActiveHousehold(userId));
      allow create: if isSignedIn() && request.auth.uid == userId &&
        request.resource.data.role in ['parent', 'child'] &&
        !request.resource.data.keys().hasAny(['premium']);
      // Users edit their own profile. A parent can update a fellow member's
      // rewards/profile basics (approving a task grants XP + coins).
      allow update: if isSignedIn() && (
        (request.auth.uid == userId &&
          request.resource.data.role == resource.data.role &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['premium'])) ||
        (isParent() && sharesActiveHousehold(userId) &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['xp', 'coins', 'name', 'avatarEmoji', 'age']))
      );
      allow delete: if false;

      // Push-notification device tokens (one doc per device, id = FCM
      // token). Private to their owner; Cloud Functions read them with
      // admin privileges. See lib/core/services/notification_service.dart.
      match /fcmTokens/{token} {
        allow read, write: if isSignedIn() && request.auth.uid == userId;
      }
    }

    match /households/{householdId} {
      // --- membership-change helpers (before = resource, after = request.resource)
      function added() {
        return request.resource.data.memberIds.removeAll(resource.data.memberIds);
      }
      function removed() {
        return resource.data.memberIds.removeAll(request.resource.data.memberIds);
      }
      function changedKeys() {
        return request.resource.data.diff(resource.data).affectedKeys();
      }
      function isOwner() {
        return resource.data.get('ownerId', null) == request.auth.uid;
      }
      // The admin must always stay a member.
      function ownerStillMember() {
        let owner = request.resource.data.get('ownerId', null);
        return owner == null || request.resource.data.memberIds.hasAny([owner]);
      }
      // What a non-admin member may do to memberIds.
      function memberChangeAllowed() {
        return !changedKeys().hasAny(['memberIds']) ||
          // Leave the household (the admin hands the role over first).
          (added().size() == 0 && removed().size() == 1 &&
            removed()[0] == request.auth.uid && !isOwner()) ||
          // A parent removes a child.
          (isParent() && added().size() == 0 && removed().size() == 1 &&
            userData(removed()[0]).role == 'child') ||
          // A parent adds a child account they just created in the app.
          (isParent() && removed().size() == 0 && added().size() == 1 &&
            userData(added()[0]).get('createdByParentId', null) == request.auth.uid);
      }

      allow read: if isSignedIn();
      allow create: if isSignedIn() &&
        request.resource.data.ownerId == request.auth.uid &&
        request.resource.data.memberIds == [request.auth.uid] &&
        !request.resource.data.keys().hasAny(['premiumUntil']);
      // A new household name: 1-40 characters (AppConstants.householdNameMaxLength).
      function nameValid() {
        return !changedKeys().hasAny(['name']) || (
          request.resource.data.name is string &&
          request.resource.data.name.trim().size() > 0 &&
          request.resource.data.name.size() <= 40);
      }

      // premiumUntil is server-only, even for the admin.
      allow update: if isSignedIn() && resource.data.memberIds.hasAny([request.auth.uid]) && ownerStillMember() &&
        !changedKeys().hasAny(['premiumUntil']) && nameValid() && (
        // Admin: anything (approve/remove members, hand over admin, rename, ...).
        isOwner() ||
        // Other members: time zone / allowed membership changes. Only the
        // admin can rename the household.
        (changedKeys().hasOnly(['timezone', 'memberIds']) && memberChangeAllowed()) ||
        // Households from before admins existed: a parent member records the
        // first member (the creator) as admin.
        (resource.data.get('ownerId', null) == null && isParent() &&
          changedKeys().hasOnly(['ownerId']) &&
          resource.data.memberIds.hasAny([request.resource.data.ownerId]))
      );
      allow delete: if false;

      // Photo proof is a Premium feature: a task or schedule can only be
      // switched to requiring a photo while the household has Premium. One
      // that already requires it can still be edited after Premium lapses.
      function photoSettingAllowed() {
        return request.resource.data.get('requiresPhoto', false) != true ||
          householdHasPremium(householdId) ||
          (resource != null && resource.data.get('requiresPhoto', false) == true);
      }

      // Join requests: the requester files their own; members can see them;
      // the admin approves (adds to memberIds + deletes) or declines (deletes);
      // the requester can cancel (delete).
      match /joinRequests/{userId} {
        allow read: if isSignedIn() &&
          (request.auth.uid == userId || isMemberOf(householdId));
        allow create: if isSignedIn() && request.auth.uid == userId &&
          request.resource.data.userId == userId &&
          !householdData(householdId).memberIds.hasAny([userId]);
        allow update: if false;
        allow delete: if isSignedIn() && (request.auth.uid == userId ||
          householdData(householdId).get('ownerId', null) == request.auth.uid);
      }

      // Tasks. Parents may change anything. Everyone else (children) is
      // limited to the to-do flow, so photo proof can't be skipped and the
      // photo (which the cleanup function deletes whenever `proof` goes
      // away) can't be removed except by taking back their own submission:
      // - can't approve, or change whether a photo is required;
      // - pending -> completed on a photo task needs a proof photo stored
      //   under this task's folder;
      // - `proof` only changes on submit (pending -> completed) or when the
      //   assignee takes back a submission (completed -> pending, proof
      //   removed);
      // - can't delete tasks.
      match /tasks/{taskId} {
        function isParentMember() {
          return isMemberOf(householdId) && isParent();
        }
        function taskChanged() {
          return request.resource.data.diff(resource.data).affectedKeys();
        }
        function statusOf(data) {
          return data.get('status', 'pending');
        }
        function hasOwnProofPhoto(data) {
          let proof = data.get('proof', null);
          return proof is map && proof.get('photoPath', null) is string &&
            proof.photoPath.matches(
            'households/' + householdId + '/taskPhotos/' + taskId + '/[^/]+');
        }
        function isSubmitting() {
          return statusOf(resource.data) == 'pending' &&
            statusOf(request.resource.data) == 'completed';
        }
        function isTakingBack() {
          return statusOf(resource.data) == 'completed' &&
            statusOf(request.resource.data) == 'pending' &&
            resource.data.get('assignedToUserId', null) == request.auth.uid &&
            !('proof' in request.resource.data);
        }
        // Without Premium, photo proof is switched off: tasks that ask for a
        // photo can be finished without one.
        function photoRequirementMet() {
          return !isSubmitting() ||
            resource.data.get('requiresPhoto', false) != true ||
            hasOwnProofPhoto(request.resource.data) ||
            !householdHasPremium(householdId);
        }
        function proofChangeAllowed() {
          return !taskChanged().hasAny(['proof']) ||
            (isSubmitting() && hasOwnProofPhoto(request.resource.data)) ||
            isTakingBack();
        }
        function childUpdateAllowed() {
          return !taskChanged().hasAny(['requiresPhoto']) &&
            statusOf(request.resource.data) != 'approved' &&
            photoRequirementMet() &&
            proofChangeAllowed();
        }

        allow read: if isMemberOf(householdId);
        allow create: if isMemberOf(householdId) && photoSettingAllowed();
        allow update: if (isParentMember() && photoSettingAllowed()) ||
          (isMemberOf(householdId) && childUpdateAllowed());
        allow delete: if isParentMember();
      }

      // Repeating-task schedules. The server (Cloud Functions) turns each
      // into one ordinary task per occurrence under /tasks.
      match /taskSchedules/{scheduleId} {
        allow read, delete: if isMemberOf(householdId);
        allow create, update: if isMemberOf(householdId) && photoSettingAllowed();
      }

        // Cooperative household goals and their contribution records.
        match /goals/{goalId} {
          allow read, write: if isMemberOf(householdId);

        match /contributions/{activityId} {
          allow read, write: if isMemberOf(householdId);
        }
      }

      match /rewards/{rewardId} {
        allow read, write: if isMemberOf(householdId);
      }

      match /redemptions/{redemptionId} {
        allow read, write: if isMemberOf(householdId);
      }
    }
  }
}
