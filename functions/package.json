{
  "name": "famotive-functions",
  "description": "Cloud Functions for Famotive (push notifications)",
  "private": true,
  "main": "lib/index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "test": "tsc && node --test \"lib/**/*.test.js\"",
    "serve": "npm run build && firebase emulators:start --only functions,firestore",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log",
    "test:emulator": "tsc && cd .. && firebase emulators:exec --project demo-famotive --only firestore,functions \"node --test functions/lib/emulator/*.emulator.js\""
  },
  "dependencies": {
    "firebase-admin": "^13.0.0",
    "firebase-functions": "^6.3.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^4.0.1",
    "@types/node": "^22.0.0",
    "firebase": "^11.10.0",
    "typescript": "^5.6.0"
  }
}
